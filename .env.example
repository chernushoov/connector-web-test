# ============================================
# CONNECTOR 2.0 - Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Application
NEXT_PUBLIC_APP_URL=https://connector.app

# API Configuration
NEXT_PUBLIC_API_URL=/api

# Feature Flags
NEXT_PUBLIC_ENABLE_SMS=false
NEXT_PUBLIC_ENABLE_PUSH=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# External Services
SMS_PROVIDER=twilio
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=

# SMS Provider Configuration (Server-side only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Database (Server-side only)
DATABASE_URL=

# Authentication (Server-side only)
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=30d

# Payment Provider (Server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
