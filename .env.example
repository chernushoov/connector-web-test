# ============================================
# CONNECTOR 2.0 - Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# SUPABASE (Required)
# ============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# STRIPE (Required for payments)
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# OPENAI (Required for AI features)
# ============================================
OPENAI_API_KEY=sk-...

# ============================================
# ADMIN JWT (Required for admin panel)
# ============================================
ADMIN_JWT_SECRET=your-super-secret-admin-jwt-key-min-32-chars

# ============================================
# FEATURE FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_SMS=true
NEXT_PUBLIC_ENABLE_PUSH=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_AI_SUPPORT=true
NEXT_PUBLIC_ENABLE_AI_MODERATION=true
NEXT_PUBLIC_ENABLE_AI_ANALYTICS=true

# ============================================
# OPTIONAL: SMS Provider (if not using Supabase Phone Auth)
# ============================================
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ============================================
# OPTIONAL: Push Notifications
# ============================================
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@connector.app

# ============================================
# AI AGENT (Required for 24/7 automation)
# ============================================
# Secret for cron job authentication
CRON_SECRET=your-cron-secret-min-32-chars

# Telegram bot for daily reports
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email recipients for reports (comma-separated)
REPORT_EMAILS=

# ============================================
# OPTIONAL: Analytics & Monitoring
# ============================================
# NEXT_PUBLIC_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=
